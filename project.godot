; Engine configuration file.

config_version=5

[application]

config/name="Interaction System Test"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://test_main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/initial_position_type=1

[editor_plugins]

enabled=PackedStringArray("res://addons/interaction_system/plugin.cfg", "res://addons/canvas_plane/plugin.cfg")

[xr]

openxr/enabled=true
shaders/enabled=true
